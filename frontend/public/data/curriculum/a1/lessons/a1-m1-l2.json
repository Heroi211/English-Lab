  "warmUp": {
    "title": "Pronomes em português",
    "prompt": "Em português usamos eu, você, ele, ela… Quais são as palavras equivalentes em inglês? Tente traduzir: \"Ele é meu amigo.\"",
    "reflectionQuestions": [
      "Who is \"I\" in a sentence?",
      "When do we use they?"
    ]
  },
  "explanation": "Subject pronouns replace the name of a person or thing as the subject of a sentence.\n\nI = eu | you = você/vocês | he = ele | she = ela | it = ele/ela (coisas/animais) | we = nós | they = eles/elas\n\nExample: Maria is a student. → She is a student.\n\nUse they for plural or when gender is unknown: They are my friends.",
  "grammar": {
    "ruleId": "a1-subject-pronouns",
    "title": "Subject Pronouns",
    "rule": "Subject pronouns come before the verb. I and you are the same for singular and plural in English. He = male, she = female, it = things/animals. They = plural.",
    "examples": [
      {
        "sentence": "I am Brazilian.",
        "note": "First person"
      },
      {
        "sentence": "She is my sister.",
        "note": "Female"
      },
      {
        "sentence": "They are students.",
        "note": "Plural"
      }
    ]
  },
