  "warmUp": {
    "title": "Plural em inglês",
    "prompt": "Como formamos o plural em português? Em inglês a regra principal é +s, mas há exceções!",
    "reflectionQuestions": [
      "One child, two ___?",
      "One mouse, two ___?"
    ]
  },
  "explanation": "Regular plurals: add -s (book → books) | -es after s, x, ch, sh (box → boxes, watch → watches) | consonant + y → -ies (city → cities)\n\nIrregular: man → men, woman → women, child → children, person → people, tooth → teeth, foot → feet, mouse → mice\n\nThis/that + singular | These/those + plural",
  "grammar": {
    "ruleId": "a1-plurals",
    "title": "Plural Nouns",
    "rule": "Most nouns add -s for plural. Learn high-frequency irregular plurals. Verb agreement: one book → it is; two books → they are.",
