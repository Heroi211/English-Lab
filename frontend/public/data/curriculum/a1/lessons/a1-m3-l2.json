  "title": "Have / Has",
  "estimatedMinutes": 40,
  "objectives": [
    "Use I/you/we/they have and he/she/it has.",
    "Talk about possession and family.",
    "Form negatives and questions with do/does."
  ],
  "canDo": "I can say what I and other people have using have and has.",
  "warmUp": {
    "title": "Ter",
    "prompt": "Em português \"eu tenho, ele tem\". In English: I have, he has — notice the -s on has!",
    "reflectionQuestions": [
      "She have or she has?"
    ]
  },
  "explanation": "Possession: I/you/we/they have | he/she/it has\n\nI have a brother. | She has two cats.\n\nNegative: don't have / doesn't have → He doesn't have a car.\nQuestions: Do you have…? / Does she have…?\n\nHave is also used for meals: have breakfast, have lunch.",
  "grammar": {
    "ruleId": "a1-have-has",
    "title": "Have / Has",
    "rule": "Have with I, you, we, they. Has with he, she, it. Questions and negatives use do/does + base have: Does he have a bike?",
    "examples": [
      {
        "sentence": "We have a small car.",
        "note": "Plural subject"
      },
      {
        "sentence": "She has long hair.",
        "note": "Third person -s"
      }
    ]
  },
