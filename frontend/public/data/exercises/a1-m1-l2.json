      "topic": "subject_pronouns",
      "ruleId": "a1-subject-pronouns",
      "type": "true_false",
      "question": "True or false: \"Her is from Korea.\" is correct.",
      "answer": false,
      "explanation": "Her is not a subject pronoun. Use She is from Korea."
