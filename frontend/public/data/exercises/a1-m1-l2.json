      "level": "A1",
      "topic": "subject_pronouns",
      "ruleId": "a1-subject-pronouns",
      "type": "multiple_choice",
      "question": "Marco is from Italy. Which pronoun replaces Marco?",
      "options": [
        "He",
        "She",
        "It",
        "They"
      ],
      "answer": "He",
      "explanation": "Marco is a male person → subject pronoun he."
    },
    {
      "id": "ex_a1_m1_l2_02",
      "level": "A1",
      "topic": "subject_pronouns",
      "ruleId": "a1-subject-pronouns",
      "type": "multiple_choice",
      "question": "Ms. Lee is the teacher. Which pronoun replaces Ms. Lee?",
      "options": [
        "He",
        "She",
        "We",
        "They"
      ],
      "answer": "She",
      "explanation": "Ms. Lee is a female person → she."
    },
    {
