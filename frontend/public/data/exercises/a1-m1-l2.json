      "topic": "subject_pronouns",
      "ruleId": "a1-subject-pronouns",
      "type": "multiple_choice",
      "question": "Laura and Marco are classmates. Which pronoun replaces Laura and Marco?",
      "options": [
        "He",
        "She",
        "It",
        "They"
      ],
      "answer": "They",
      "explanation": "Two people → they."
    },
    {
